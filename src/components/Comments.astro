---
import { SITE } from '../config/site';

// 붙여넣은 giscus 스크립트에서 data-* 속성만 추출
const giscusAttrs = Object.fromEntries(
  [...SITE.comments.giscusScript.matchAll(/data-([\w-]+)="([^"]*)"/g)].map((m) => [m[1], m[2]])
);

const isCommentsEnabled = Boolean(giscusAttrs.repo);
---

{isCommentsEnabled && (
  <section class="comments-section">
    <h3 class="comments-title">댓글</h3>
    <div class="comments-container"></div>
  </section>
)}

{isCommentsEnabled && (
  <script is:inline define:vars={{ giscusAttrs }}>
    // giscus는 스크립트 실행 시점의 data-theme으로 로드되므로, 현재 테마를 넣어 직접 삽입
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    for (const [key, value] of Object.entries(giscusAttrs)) {
      script.setAttribute(`data-${key}`, value);
    }
    const theme = document.documentElement.getAttribute('data-theme');
    script.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
    script.crossOrigin = 'anonymous';
    script.async = true;
    document.querySelector('.comments-container').appendChild(script);
  </script>
)}

<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #ccc;
  }
  
  .comments-title {
    margin-bottom: 1.5rem;
    color: #333;
    font-size: 1.2rem;
    font-weight: 600;
  }
  
  .comments-container {
    width: 100%;
  }
  
  /* 다크모드 스타일 */
  :global(html[data-theme="dark"]) .comments-section {
    border-top-color: #555;
  }
  
  :global(html[data-theme="dark"]) .comments-title {
    color: #f0f0f0;
  }
</style>