---
interface Heading {
  id: string;
  text: string;
  level: number;
}

interface Props {
  headings: Heading[];
  // side: 본문 옆에 고정되는 목차 (넓은 화면), inline: 본문 위의 접이식 목차 (좁은 화면)
  variant?: 'side' | 'inline';
}

const { headings, variant = 'side' } = Astro.props;

// 헤딩이 없으면 컴포넌트를 렌더링하지 않음
const hasHeadings = headings && headings.length > 0;

// 목차의 깊이는 그 글에서 가장 높은 헤딩을 1로 하는 상대값
// (h3만 쓰는 글도 최상위 항목으로 표시되도록)
const topLevel = Math.min(...headings.map((heading) => heading.level));
const items = headings.map((heading) => ({ ...heading, depth: heading.level - topLevel + 1 }));
---

{hasHeadings && variant === 'side' && (
  <aside class="table-of-contents">
    <nav class="toc-nav">
      <h3 class="toc-title">목차</h3>
      <ul class="toc-list">
        {items.map((heading) => (
          <li class={`toc-item toc-level-${heading.depth}`}>
            <a href={`#${heading.id}`} class="toc-link" data-heading-id={heading.id}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

{hasHeadings && variant === 'inline' && (
  <details class="toc-inline">
    <summary class="toc-inline-summary">목차</summary>
    <nav>
      <ul class="toc-list">
        {items.map((heading) => (
          <li class={`toc-item toc-level-${heading.depth}`}>
            <a href={`#${heading.id}`} class="toc-link" data-heading-id={heading.id}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

{hasHeadings && (
  <script>
    // TOC 기능 초기화
    function initTableOfContents() {
      // 옆 목차와 접이식 목차가 같은 헤딩을 가리키므로, 링크와 헤딩을 따로 모은다
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
      const headings = [...new Set(links.map((link) => link.dataset.headingId ?? ''))]
        .map((id) => document.getElementById(id))
        .filter((heading): heading is HTMLElement => heading !== null);

      if (headings.length === 0) return;

      // 헤딩 상단이 이 선(뷰포트 상단 기준 px)을 지나면 그 섹션을 읽는 중으로 본다.
      // 목차 클릭 시 헤딩이 멈추는 위치(scroll-margin-top)보다 조금 아래로 잡는다.
      const activeLine = parseFloat(getComputedStyle(headings[0]).scrollMarginTop) + 25;

      function setActive(headingId?: string) {
        links.forEach((link) => link.classList.toggle('active', link.dataset.headingId === headingId));
      }

      // 스크롤 위치 기준으로 현재 섹션 계산
      function updateActiveFromScroll() {
        // 페이지 끝에서는 마지막 헤딩이 기준선까지 올라오지 못하므로 마지막 항목을 활성화
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        let current = atBottom ? headings[headings.length - 1] : undefined;

        if (!current) {
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top > activeLine) break;
            current = heading;
          }
        }

        setActive(current?.id);
      }

      // 목차 클릭으로 스크롤되는 동안에는 클릭한 항목을 유지
      let clickScrolling = false;
      let unlockTimer = 0;
      const unlock = () => {
        clickScrolling = false;
        window.clearTimeout(unlockTimer);
      };
      window.addEventListener('scrollend', unlock);

      links.forEach((link) => {
        const heading = document.getElementById(link.dataset.headingId ?? '');
        if (!heading) return;

        link.addEventListener('click', (e) => {
          e.preventDefault();

          setActive(heading.id);
          clickScrolling = true;
          window.clearTimeout(unlockTimer);
          // scrollend가 오지 않는 경우(미지원 브라우저, 이미 그 위치인 경우) 대비
          unlockTimer = window.setTimeout(unlock, 1500);

          heading.scrollIntoView({ behavior: 'smooth', block: 'start' });

          // URL 업데이트 (히스토리에 추가하지 않음)
          history.replaceState(null, '', `#${heading.id}`);
        });
      });

      let ticking = false;
      window.addEventListener('scroll', () => {
        if (clickScrolling || ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          if (!clickScrolling) updateActiveFromScroll();
        });
      }, { passive: true });

      // 초기 상태 설정
      updateActiveFromScroll();
    }

    // DOM 로드 후 실행
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTableOfContents);
    } else {
      initTableOfContents();
    }
  </script>
)}

<style>
  .table-of-contents {
    position: fixed;
    top: 120px; /* 플로팅 네비게이션 고려 */
    left: calc(50% + 432px + 1rem); /* 컨테이너 오른쪽 끝(800px/2 + 2rem) + 간격 */
    right: 1rem;
    max-width: 250px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    z-index: 10;
  }

  .toc-nav {
    background: rgba(249, 249, 249, 0.9);
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .toc-title {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 0.5rem;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    color: #666;
    text-decoration: none;
    padding: 0.3rem 0;
    font-size: 0.9rem;
    line-height: 1.4;
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
    margin-left: -0.5rem;
    transition: all 0.2s ease;
  }

  .toc-link:hover {
    color: #007acc;
    border-left-color: #007acc;
  }

  .toc-link.active {
    color: #007acc;
    border-left-color: #007acc;
    font-weight: 500;
  }

  /* 깊이별 들여쓰기: 왼쪽 강조선은 같은 위치에 두고 글자만 안쪽으로 민다 */
  .toc-level-1 .toc-link {
    font-weight: 500;
  }

  .toc-level-2 .toc-link {
    padding-left: 1.25rem;
    font-size: 0.85rem;
  }

  .toc-level-3 .toc-link {
    padding-left: 2rem;
    font-size: 0.8rem;
    color: #888;
  }

  /* 접이식 목차 (좁은 화면에서 본문 위에 표시) */
  .toc-inline {
    display: none;
    margin-bottom: 2rem;
    padding: 0.75rem 1.5rem;
    background: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  }

  .toc-inline-summary {
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
  }

  .toc-inline[open] .toc-inline-summary {
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e0e0e0;
  }

  /* 다크모드 스타일 */
  :global(html[data-theme="dark"]) .toc-inline {
    background: #333;
    border-color: #555;
  }

  :global(html[data-theme="dark"]) .toc-inline-summary {
    color: #f0f0f0;
    border-bottom-color: #555;
  }

  :global(html[data-theme="dark"]) .toc-nav {
    background: rgba(45, 45, 45, 0.95);
    border-color: #555;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global(html[data-theme="dark"]) .toc-title {
    color: #f0f0f0;
    border-bottom-color: #555;
  }

  :global(html[data-theme="dark"]) .toc-link {
    color: #b4b4b4;
  }

  :global(html[data-theme="dark"]) .toc-link:hover {
    color: #1e90ff;
    border-left-color: #1e90ff;
  }

  :global(html[data-theme="dark"]) .toc-link.active {
    color: #1e90ff;
    border-left-color: #1e90ff;
  }

  :global(html[data-theme="dark"]) .toc-level-3 .toc-link {
    color: #999;
  }

  /* 화면이 좁을 때 TOC 숨김 */
  @media (max-width: 1299px) {
    .table-of-contents {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }
</style>